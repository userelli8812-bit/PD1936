# TWRP recovery fstab for vivo PD1936 (Qualcomm sm6150)
# Fixed: removed unsupported mount options, added missing partitions

# system
/system              ext4    /dev/block/bootdevice/by-name/system                flags=display="System";backup=1;flashimg

# vendor
/vendor              ext4    /dev/block/bootdevice/by-name/vendor                flags=display="Vendor";backup=1

# metadata
/metadata            ext4    /dev/block/bootdevice/by-name/metadata              flags=display="Metadata";backup=1;canbewiped;wipeingui

# data (FBE with inline encryption - vivo specific)
/data                f2fs    /dev/block/bootdevice/by-name/userdata              flags=display="Data";backup=1;encryptable=footer;fileencryption=ice;wrappedkey;wipeingui;flashimg

# cache
/cache               ext4    /dev/block/bootdevice/by-name/cache                 flags=display="Cache";backup=1;wipeingui

# oem
/oem                 ext4    /dev/block/bootdevice/by-name/oem                   flags=display="oem";backup=1

# modem firmware
/vendor/firmware_mnt vfat    /dev/block/bootdevice/by-name/modem                 flags=display="Modem";backup=1;flashimg

# dsp
/vendor/dsp          ext4    /dev/block/bootdevice/by-name/dsp                   flags=display="DSP";backup=1

# persist
/persist             ext4    /dev/block/bootdevice/by-name/persist               flags=display="Persist";backup=1;wipeingui

# bluetooth firmware
/vendor/bt_firmware  vfat    /dev/block/bootdevice/by-name/bluetooth             flags=display="Bluetooth Firmware";backup=1;flashimg

# boot
/boot                emmc    /dev/block/bootdevice/by-name/boot                  flags=display="Boot";backup=1;flashimg

# recovery
/recovery            emmc    /dev/block/bootdevice/by-name/recovery              flags=display="Recovery";backup=1;flashimg

# misc (needed by update_engine to detect boot device)
/misc                emmc    /dev/block/bootdevice/by-name/misc                  flags=display="Misc"

# vbmeta
/vbmeta              emmc    /dev/block/bootdevice/by-name/vbmeta                flags=display="Vbmeta";backup=1;flashimg

# dtbo
/dtbo                emmc    /dev/block/bootdevice/by-name/dtbo                  flags=display="Dtbo";backup=1;flashimg

# external SD card
/external_sd         vfat    /dev/block/mmcblk1p1                                flags=display="Micro SD card";removable;storage;wipeingui

# USB OTG
/usb_otg             vfat    /dev/block/sdg1                                     flags=display="USB OTG";removable;storage;wipeingui
